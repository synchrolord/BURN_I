# Track Unity project sources and game builds.
/*
!/Assets/
!/Packages/
!/ProjectSettings/
!/Builds/
!/Build/

# Keep Git configuration.
!/.gitignore
!/.gitattributes

# Local reference, recovery, and duplicate asset folders.
/Assets/_Recovery/
/Assets/Legacy/
/Assets/celeste stuff/

# Editor/OS-generated files inside tracked folders.
.vs/
.idea/
*.csproj
*.sln
.DS_Store
Thumbs.db
desktop.ini
/Assets/_Recovery.meta
/Assets/Legacy.meta
/Assets/celeste stuff.meta

